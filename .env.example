BOT_TOKEN=0011
API_ID=0011
API_HASH=0011
ADMIN_ID=0011
FSUB_CHANNEL=-0011
FSUB_CHANNEL_LINK=xyz.0011

# ---- Optional ----
# Instagram cookies (yt-dlp ke liye) — private/logged-in content ke liye
# COOKIES_FILE=downloads/.cookies.txt
# COOKIES_CONTENT=<cookies.txt ka raw text yahan paste karo>

# Instaloader login session (Instagram rate-limit/private posts ke liye)
# Pehle apne PC pe chalao: instaloader --login=<username>
# IG_USERNAME=your_ig_username
# IG_SESSION_FILE=/path/to/session-file

# Cobalt universal downloader API (last-resort fallback)
# COBALT_API_URL=https://api.cobalt.tools/api/json
# COBALT_API_KEY=
